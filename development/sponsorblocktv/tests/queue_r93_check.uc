'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import {snapshot,command} from './lib/live.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(v,m){if(!v)die(m);}
let a=YtLoungeApi({screen_id:'fixture',lounge_token:'token'});
a._sid='s';a._gsession='g';a._subscribe_active=true;
let l={phase:'connected',lounge:a};
a.on_state_change=(st)=>{l._current_state={...st};l._time_start=util.monotonic_ms();};
let cur='abcdefghijk',target='lmnopqrstuv',other='01234567890',calls=[],guard,done;
a._command=(n,p,cb,err,g)=>{push(calls,[n,p]);guard=g;done=cb;};
a.get_now_playing=()=>{};
a._process_event('nowPlaying',[{videoId:cur,state:1,currentTime:15,duration:100}]);
check(!snapshot(l).queue_complete,'no invented queue');
check(command(l,'queue_add',0,target).accepted && guard() && calls[-1][0]=='addVideo','native append without queue');
a._process_event('playlistModified',[{videoIds:cur+','+target}]);done(true);
check(l.command_status=='sent','append confirmed by fresh list');
a._process_event('playlistModified',[{}]);
check(!snapshot(l).queue_complete,'unreported modified list invalidates old snapshot');
check(command(l,'queue_next',0,other).accepted && guard() && calls[-1][0]=='insertVideo','native insert without queue');
a._process_event('nowPlaying',[{videoId:cur,state:1,currentTime:16,videoIds:[cur,other,target]}]);done(true);
check(l.command_status=='sent' && snapshot(l).queue_complete,'insert confirmed from playback list');
a._process_event('playlistModified',[{}]);
check(!command(l,'queue_remove',0,target).accepted,'unknown remove blocked');
check(!command(l,'queue_move',1,target).accepted,'unknown rebuild blocked');
check(command(l,'queue_add',0,target).accepted,'unknown append accepted');
a._process_event('nowPlaying',[{videoId:other,state:1,currentTime:0}]);
check(!guard(),'stale content dispatch blocked');done(false);
check(l.command_status=='failed','stale delivery failed');
check(command(l,'queue_next',0,target).accepted && guard(),'unknown queue delivery');
done(true);
u.timer(5200,()=>{
 check(l.command_status=='delivered' && !l.command_pending && !snapshot(l).queue_complete,'delivery only, no fabricated confirmation');
 check(join(',',snapshot(l).queue_requests)==target && snapshot(l).queue==null,'separate requested list');
 a._process_event('nowPlaying',[{videoId:target,state:1,currentTime:0}]);
 check(!length(snapshot(l).queue_requests),'observed playback consumes request');
 a._connection_lost();print('PASS: native queue add and insert, verification, stale guards and honest delivery\n');u.end();
});u.run();
