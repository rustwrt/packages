'use strict';
import * as fs from 'fs';
import {read_policy,save_policy} from './lib/config.uc';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
function check(ok,msg){if(!ok)die(msg);}
function rejects(fn){try{fn();return false;}catch(e){return true;}}
let dir=ARGV[0],cfg={skip_ads:true,mute_ads:true,auto_play:true,devices:[]};
let helper=SponsorBlockClient(cfg),d={screen_id:'abcdefghijk'},d2={screen_id:'lmnopqrstuv'};
let a=DeviceListener(helper,cfg,d,false),b=DeviceListener(helper,cfg,d2,false);
a.enable_policy_store(dir);b.enable_policy_store(dir);
check(a.policy_ready && b.policy_ready,'stores available');
check(a.save_device_policy('skip_ads','0').saved && !a.lounge.skip_ads && b.lounge.skip_ads,'isolated immediate policy');
check(a.save_device_policy('mute_ads','0').saved && !a.lounge.mute_ads,'immediate mute policy');
check(a.save_device_policy('skip_sponsorblock','0').saved && !a.skip_sponsorblock,'immediate SponsorBlock policy');
check(a.save_device_policy('auto_play','0').saved && !a.lounge.auto_play,'immediate autoplay policy');
check(!a.save_device_policy('skip_ads','inherit').saved && !a.lounge.skip_ads,'inherit rejected');
check(a.save_device_policy('skip_ads','1').saved && a.lounge.skip_ads,'explicit on');
check(a.save_device_policy('skip_categories','sponsor,intro').saved && join(',',a.api_helper.skip_categories)=='sponsor,intro' && join(',',b.api_helper.skip_categories)=='sponsor','isolated categories');
check(a.save_device_policy('minimum_skip_length','4').saved && a.api_helper.minimum_skip_length==4 && b.api_helper.minimum_skip_length==1,'isolated minimum');
check(!a.save_device_policy('skip_categories','sponsor,sponsor').saved && !a.save_device_policy('minimum_skip_length','604801').saved,'bounds');
check(!a.save_device_policy('bad','1').saved && !a.save_device_policy('skip_ads','invalid').saved,'validation');
let restarted=DeviceListener(helper,cfg,d,false);restarted.enable_policy_store(dir);
check(restarted.policy_ready && restarted.lounge.skip_ads && !restarted.lounge.mute_ads && !restarted.lounge.auto_play && !restarted.skip_sponsorblock,'restart persistence');
let record=dir+'/tv-policy-'+a.public_id+'.json';
check(fs.lstat(record).uid==0 && !(fs.lstat(record).mode & 63),'private record');
check(read_policy(dir,b.public_id).skip_ads=='1' && read_policy(dir,b.public_id).skip_categories=='sponsor','other TV defaults persisted');
check(join(',',restarted.api_helper.skip_categories)=='sponsor,intro' && restarted.api_helper.minimum_skip_length==4,'filter settings persist');
fs.chmod(record,0644);
check(!a.save_device_policy('mute_ads','1').saved && !a.lounge.mute_ads,'unsafe storage fails before applying');
fs.chmod(record,0600);
check(a.save_device_policy('mute_ads','1').saved && a.lounge.mute_ads,'recover after write error');
check(rejects(()=>save_policy(dir,'../bad',{})),'invalid identifier rejected');
let legacy={screen_id:'12345678901'};
let old_cfg={skip_ads:false,mute_ads:true,auto_play:false,skip_categories:['intro'],minimum_skip_length:5,devices:[]};
let old=DeviceListener(SponsorBlockClient(old_cfg),old_cfg,legacy,false);
save_policy(dir,old.public_id,{skip_ads:'inherit',mute_ads:'0',auto_play:'inherit',skip_sponsorblock:'1'});
old.enable_policy_store(dir);
let frozen=read_policy(dir,old.public_id);
check(frozen.skip_ads=='0' && frozen.mute_ads=='0' && frozen.auto_play=='0' && frozen.skip_categories=='intro' && frozen.minimum_skip_length=='5','legacy inherited values frozen');
let changed=DeviceListener(helper,cfg,legacy,false);changed.enable_policy_store(dir);
check(!changed.lounge.skip_ads && !changed.lounge.mute_ads && !changed.lounge.auto_play && join(',',changed.api_helper.skip_categories)=='intro','old globals no longer change migrated TV');
let new_device={screen_id:'12345678902',skip_ads:true,mute_ads:true,auto_play:true,skip_sponsorblock:true,skip_categories:['sponsor'],minimum_skip_length:1};
let added=DeviceListener(SponsorBlockClient(old_cfg),old_cfg,new_device,false);added.enable_policy_store(dir);
check(added.lounge.skip_ads && added.lounge.mute_ads && added.lounge.auto_play && join(',',added.api_helper.skip_categories)=='sponsor' && added.api_helper.minimum_skip_length==1,'new seed overrides all legacy globals');
print('Real filesystem atomic policy persistence, reload, isolation and failed-write rollback OK\n');
