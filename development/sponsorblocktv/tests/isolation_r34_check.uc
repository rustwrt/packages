'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import {command,MetadataPool} from './lib/live.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let a=YtLoungeApi({screen_id:'fixture',lounge_token:'token'});
a._sid='s';a._gsession='g';a._subscribe_active=true;
a._command=(n,p,cb)=>{if(cb)cb(true);};
a._process_event('onAdStateChange',[{adState:'garbage'}]);
a._process_event('onAdStateChange',[{adState:9999}]);
check(!a._ad_active && !a._screen_confirmed,'invalid ad states ignored');
let id='abcdefghijk',ad='lmnopqrstuv';
a._process_event('nowPlaying',[{videoId:id,state:1,currentTime:15,duration:100,seekableStartTime:0,seekableEndTime:90}]);
let l={lounge:a,phase:'connected',_current_state:a._playback_state,_time_start:util.monotonic_ms(),_seek_pending:true};
let sent=0;a._command=(n,p,cb)=>{sent++;if(cb)cb(true);};
check(!command(l,'seek',40,'').accepted && sent==0,'manual seek blocked during automatic skip');
a._process_event('adPlaying',[{adVideoId:ad,isSkipEnabled:false}]);
a._process_event('onStateChange',[{state:1081,videoId:ad,duration:20,currentTime:5}]);
check(a._playback_state.videoId==id && a._playback_state.duration==100 && a._playback_state.seekableEnd==90,'ad cannot overwrite content');
a._process_event('nowPlaying',[{state:1,videoId:ad,duration:20,currentTime:6}]);
check(a._playback_state.videoId==id && !a._playback_state.position_known,'background event not promoted');
a._process_event('onAdStateChange',[{adState:'1082'}]);
a._process_event('onStateChange',[{state:1,currentTime:16}]);
check(a._playback_state.videoId==id && a._playback_state.duration==100,'partial resume keeps content identity');
let q=YtLoungeApi({screen_id:'fixture',lounge_token:'token'});
q._sid='s';q._gsession='g';
let results=[],callbacks=[];
q._send_command=(n,p,cb)=>push(callbacks,cb);
q._command('pause',{},(ok)=>push(results,ok));
q._process_events([[1,['loungeStatus',{devices:[{type:'LOUNGE_SCREEN',deviceInfo:{clientName:'TVHTML5_FOR_KIDS'}}]}]],[2,['c','stale']],[3,['S','stale']]]);
check(!q.connected() && q._command_epoch==1 && length(results)==1 && results[0]==false,'blacklist invalidates session and queued batch');
callbacks[0](true);check(length(results)==1,'stale completion ignored');
let c=SponsorBlockClient({skip_categories:['sponsor'],devices:[]});
let d=DeviceListener(c,{}, {screen_id:'fixture',name:'fixture',offset:0},false);
d._current_state={videoId:id,state:1,position_known:true,currentTime:10,duration:0};
d._time_start=util.monotonic_ms();
let target=null;d._schedule_skip=(delay,end)=>{target=end;};
d._time_to_segment([{start:10,end:200,UUID:['x']}],10);
check(target==null,'unknown duration cannot schedule');
let t=DeviceListener(c,{}, {screen_id:'fixture2',name:'fixture2',offset:0},false);
let api=t.lounge;api._sid='s';api._gsession='g';api._subscribe_active=true;t.phase='connected';
t.metadata_id=id;t.video_title='Fixture';
let auto=0;api.seek_to=()=>auto++;
c._segment_cache.set(id,[{start:10,end:20,UUID:['x']}],false);
api._process_event('nowPlaying',[{videoId:id,state:1,currentTime:12,duration:100}]);
c._segment_cache.entries[id].expires_at=util.monotonic_ms()-1;
let requests=[],pool=MetadataPool((v,cb)=>push(requests,{id:v,cb:cb})),received=0;
let valid=true;
for(let i=0;i<20;i++)pool.request(id,()=>true,(v)=>{check(v.title=='fixture','shared title');received++;});
check(length(requests)==1 && pool.active==1,'20 TVs share request');
for(let n in ['abcdefghij1','abcdefghij2','abcdefghij3','abcdefghij4'])pool.request(n,()=>valid,()=>{});
check(pool.active==3 && length(pool.queue)==2,'three active requests limit');
valid=false;pool.prune();check(length(pool.queue)==0,'obsolete queued metadata removed');
requests[0].cb({title:'fixture'},200);requests[0].cb({title:'duplicate'},200);
check(received==20 && pool.active==2,'deliver once to each listener');
pool.request(id,()=>true,(v)=>received++);
check(received==21 && length(requests)==3,'shared cache hit');
u.timer(100,()=>{
    check(auto==0,'expired segment blocks timer at dispatch');
    print('Ad isolation, manual conflict, unknown bounds, session invalidation, expiry and 20-TV metadata pooling OK\n');
    u.end();
});
u.run();
