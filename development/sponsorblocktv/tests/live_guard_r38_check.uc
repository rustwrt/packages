'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import {command,MetadataPool} from './lib/live.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let a=YtLoungeApi({screen_id:'fixture',lounge_token:'token'});
a._sid='s';a._gsession='g';a._subscribe_active=true;
let c=SponsorBlockClient({skip_categories:['sponsor'],devices:[]});
let l={phase:'connected',lounge:a,api_helper:c,_time_start:util.monotonic_ms()};
a.on_state_change=(st)=>{l._current_state={...st};l._time_start=util.monotonic_ms();};
a._process_event('nowPlaying',[{videoId:'abcdefghijk',state:1,currentTime:15,duration:100}]);
a._process_event('playlistModified',[{videoIds:'abcdefghijk,lmnopqrstuv,01234567890'}]);
let guard,callback;
a._command=(n,p,cb,err,g)=>{guard=g;callback=cb;};
check(!command(l,'volume','50','').accepted,'noninteger rejected');
check(command(l,'queue_move',1,'lmnopqrstuv').accepted,'queued reorder');
a._process_event('playlistModified',[{videoIds:'abcdefghijk,01234567890,lmnopqrstuv'}]);
check(!guard(),'changed queue rejected');callback(false);
check(!l.command_pending,'failed guard clears pending');
check(command(l,'seek',60,'').accepted,'seek accepted');
a._process_event('nowPlaying',[{state:1,currentTime:15,seekableEndTime:40}]);
check(!guard(),'changed DVR bounds rejected');callback(false);
a._process_event('onVolumeChanged',[{volume:25,muted:true}]);
a._ad_mute_owned=true;
check(command(l,'mute',0,'').accepted,'manual unmute queued');
check(a._ad_mute_owned,'mute ownership preserved before confirmation');
callback(false);check(a._ad_mute_owned,'mute failure preserves ownership');
a.queue_complete=false;
check(!command(l,'queue_remove',0,'lmnopqrstuv').accepted,'incomplete queue rejected');
let jobs=[],pool=MetadataPool((id,done)=>push(jobs,done)),received=0;
pool.request('abcdefghijk',()=>true,()=>die('fixture callback'));
pool.request('abcdefghijk',()=>true,()=>received++);
pool.request('abcdefghijk',()=>die('fixture guard'),()=>die('invalid consumer'));
for(let id in ['abcdefghij1','abcdefghij2','abcdefghij3'])pool.request(id,()=>true,()=>received++);
jobs[0]({title:'ok'},200);
check(received==1 && length(jobs)==4 && pool.active==3,'callback failure cannot block other TVs or queue');
print('RPC validation, fresh DVR and queue guards, mute ownership, metadata fanout OK\n');
