'use strict';
import {watch_channel_id,ChannelResolver,SponsorBlockClient} from './lib/sponsorblock.uc';
import {validate_runtime_config} from './lib/config.uc';
import {YtLoungeApi} from './lib/lounge.uc';
import {command} from './lib/live.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let vid='abcdefghijk',ch='UCabcdefghijklmnopqrstuv',other='UC1234567890123456789012';
function page(video,channel){return '<script nonce="fixture">var ytInitialPlayerResponse = '+sprintf('%J',{videoDetails:{videoId:video,channelId:channel,title:'quoted " title'}})+';</script>';}
check(watch_channel_id(page(vid,ch),vid)==ch,'structured channel lookup');
check(watch_channel_id(page('lmnopqrstuv',ch),vid)==null,'wrong video rejected');
check(watch_channel_id(page(vid,'bad'),vid)==null,'invalid channel rejected');
check(watch_channel_id('<script>var ytInitialData = {"channelId":"'+ch+'"};</script>',vid)==null,'unrelated channel rejected');
check(watch_channel_id('<script>var ytInitialPlayerResponse = {oops};</script>',vid)==null,'malformed player response rejected');
let calls=[],answers=[],resolve=ChannelResolver((id,cb)=>push(calls,[id,cb]));
resolve(vid,(c)=>push(answers,c));resolve(vid,(c)=>push(answers,c));
check(length(calls)==1,'shared in-flight request');
resolve('lmnopqrstuv',(c)=>push(answers,c));resolve('01234567890',(c)=>push(answers,c));
check(length(calls)==2 && answers[0]==null,'global concurrency cap');
calls[0][1](ch);check(length(answers)==3 && answers[1]==ch && answers[2]==ch,'both waiters served');
resolve(vid,(c)=>push(answers,c));check(length(calls)==2 && answers[3]==ch,'shared positive cache');
calls[1][1](null);resolve('lmnopqrstuv',(c)=>push(answers,c));check(length(calls)==2 && answers[4]==null && answers[5]==null,'failure cached briefly');
let cfg={devices:[],apikey:'',channel_whitelist:[{id:ch}],skip_categories:['sponsor']};
check(validate_runtime_config(cfg,true),'whitelist accepts no key');
let a=SponsorBlockClient(cfg,resolve),b=SponsorBlockClient({...cfg,channel_whitelist:[{id:other}]},resolve);
let result=null,errors=0;
a.is_whitelisted(vid,(v)=>result=v,()=>errors++);check(result===true,'keyless exempt channel');
b.is_whitelisted(vid,(v)=>result=v,()=>errors++);check(result===false,'non-exempt exact match');
a.is_whitelisted('lmnopqrstuv',(v)=>die('unknown must not authorize skip'),()=>errors++);
check(errors==1,'unknown channel fails closed');
a.get_segments('lmnopqrstuv',(v)=>die('unknown channel must not produce segments'),()=>errors++);
check(errors==2,'no SponsorBlock request on unknown channel');
let empty=SponsorBlockClient({channel_whitelist:[]},()=>die('empty whitelist must not query'));
empty.is_whitelisted(vid,(v)=>check(v===false,'no whitelist no extra lookup'));
let lounge=YtLoungeApi({screen_id:'fixture',lounge_token:'token',auto_play:true});
lounge._sid='sid';lounge._gsession='gs';lounge._subscribe_active=true;
let sent=[],callbacks=[];
lounge._send_command=(n,p,cb)=>{push(sent,[n,p]);push(callbacks,cb);};
lounge._process_event('onAutoplayModeChanged',[{autoplayMode:'DISABLED'}]);
lounge._process_event('onAutoplayModeChanged',[{autoplayMode:'DISABLED'}]);
check(length(sent)==1 && length(lounge._command_queue)==0,'duplicate autoplay enforcement deduped');
lounge.auto_play=false;lounge.set_auto_play_mode(false);
lounge._process_event('onAutoplayModeChanged',[{autoplayMode:'ENABLED'}]);
callbacks[0](true);
check(length(sent)==2 && sent[1][1].autoplayMode=='DISABLED','latest policy wins over old in-flight request');
lounge._process_event('onAutoplayModeChanged',[{autoplayMode:'DISABLED'}]);callbacks[1](true);
check(!command({lounge:lounge},'autoplay',1,'').accepted && !lounge.auto_play,'legacy control cannot mutate policy');
print('Keyless whitelist parsing, shared cache, safe failure and autoplay arbitration OK\n');
