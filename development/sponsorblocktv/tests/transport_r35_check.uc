'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let a=YtLoungeApi({screen_id:'fixture',lounge_token:'fixture'});
a._sid='s';a._gsession='g';
let n=0;a.on_event=(e)=>n++;
a._process_events([[1,['noop']],[2,['noop']]]);
a._process_events([[1,['noop']],[2,['noop']]]);
check(n==2,'replayed IDs ignored');
a._process_events([[3,['noop']],null,{},[99,null]]);
check(n==3 && a._last_event_id==3,'malformed tail leaves last valid cursor');
a._process_events([[4,['noop']]]);
check(n==4,'valid next packet processed');
let callbacks=[],sent=[],results=[];
a._send_command=(name,p,cb)=>{push(sent,name);push(callbacks,cb);};
a._command('getVolume',{},()=>{});
a._command('seekTo',{},(ok)=>push(results,ok),null,()=>die('fixture guard'));
a._command('pause',{},(ok)=>push(results,ok));
callbacks[0](true);
check(length(sent)==2 && sent[1]=='pause' && length(results)==1 && !results[0],'guard failure isolated');
callbacks[1](true);
check(length(results)==2 && results[1] && !a._command_mutex,'queue drains normally');
let b=YtLoungeApi({screen_id:'fixture',lounge_token:'fixture'});
let delivered=[],raw='[[1,\n["noop"]]]\n';
check(b._parse_event_chunks(length(raw)+'\n'+raw,events=>push(delivered,events)) && length(delivered)==1,'multiline frame parsed');
check(!b._parse_event_chunks('100\n'+raw,()=>die('partial frame delivered')),'truncated frame rejected');
check(!b._parse_event_chunks('9999999\n',()=>{}),'oversize frame rejected');
let c=YtLoungeApi({screen_id:'fixture',lounge_token:'fixture'});
c._sid='s';c._gsession='g';
let failures=0;
c._send_command=()=>die('fixture transport');
c._command('pause',{},(ok)=>{if(!ok)failures++;});
check(!c._command_mutex && failures==1,'transport exception completes command');
c._send_command=(n,p,cb)=>cb(true);
c._command('play',{},(ok)=>{if(ok)failures++;die('fixture callback');});
c._command('pause',{},(ok)=>{if(ok)failures++;});
check(failures==3 && !c._command_mutex,'callback exception cannot block following command');
let d=YtLoungeApi({screen_id:'fixture',lounge_token:'fixture'});
d._sid='s';d._gsession='g';d._subscribe_active=true;
let aborted=0;
d._subscribe_abort=()=>{aborted++;d._subscribe_active=false;};
d._subscribe_buffer='bad_length\n';d._chunk_remaining=-1;
d._process_subscribe_buffer();
check(aborted==1 && !d.connected(),'malformed frame aborts transport');
print('Replay, malformed frames, cursor, queue recovery, callback isolation and subscription abort OK\n');
