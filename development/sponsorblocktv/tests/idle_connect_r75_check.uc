'use strict';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import {snapshot} from './lib/live.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let cfg={devices:[],skip_categories:[],skip_ads:true,mute_ads:true};
let l=DeviceListener(SponsorBlockClient(cfg),cfg,{screen_id:'fixture',name:'TV'},false);
let a=l.lounge,requests=[],sent=[];
a.lounge_token='token';
a.is_available=(cb,err)=>push(requests,[cb,err]);
a.connect=(cb)=>{a._sid='s';a._gsession='g';cb(true);};
a.subscribe=(cb)=>{a._subscribe_active=true;a._last_event_time=util.monotonic_ms();};
a._send_command=(n,p,cb)=>{push(sent,n);cb(true);};
l._run_loop();requests[0][0](true);
check(snapshot(l).connection=='checking' && !snapshot(l).video_id,'cloud availability is not screen confirmation');
check(!snapshot(l).mute_known && sent[0]=='getVolume','prewarm volume without guessing');
l._check_screen_presence();l._check_screen_presence();
check(length(requests)==2,'single idle presence probe');
requests[1][0](true);
check(snapshot(l).connection=='checking','online cloud reply alone does not connect');
a._process_event('onVolumeChanged',[{volume:40,muted:false}]);
check(snapshot(l).connection=='connected' && snapshot(l).playback==-2 && !snapshot(l).video_id,'TV volume confirms idle connection before first video');
a._last_screen_event_time=util.monotonic_ms()-13000;
l._check_screen_presence();a._process_event('nowPlaying',[{videoId:'abcdefghijk',state:1,currentTime:1}]);
requests[2][0](false);
check(snapshot(l).connection=='connected' && snapshot(l).playback==1,'new playback beats stale offline reply');
a._last_screen_event_time=util.monotonic_ms()-19000;
a._process_event('noop',[]);
l._check_screen_presence();requests[3][0](true);
check(snapshot(l).connection=='offline' && !snapshot(l).video_id,'cached cloud online cannot renew expired screen evidence');
l._check_screen_presence();requests[4][0](false);
check(snapshot(l).connection=='offline','confirmed absence overrides presence');
a._process_event('loungeStatus',[{devices:[{type:'LOUNGE_SCREEN',id:'screen'}]}]);
check(snapshot(l).connection=='connected','screen roster recovers without video');
a._process_event('loungeStatus',[{devices:[{type:'REMOTE_CONTROL',id:'remote'}]}]);
check(snapshot(l).connection=='offline','screen absence immediate');
if(l._status_timer)l._status_timer.cancel();
a._connection_lost();
l.phase='offline';
l._run_loop();requests[5][0](true);
check(snapshot(l).connection=='offline','cached cloud online and successful bind cannot clear offline latch');
l._check_screen_presence();requests[6][0](true);
check(snapshot(l).connection=='offline','repeated positive cannot clear latch');
a._process_event('onVolumeChanged',[{volume:40,muted:false}]);
check(snapshot(l).connection=='connected','fresh TV response clears latch');
if(l._status_timer)l._status_timer.cancel();
a._connection_lost();
print('Idle confirmation, stale cloud online rejection, reconnect latch and recovery OK\n');
