'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import {command} from './lib/live.uc';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
function api(opts){
    let a=YtLoungeApi({screen_id:'fixture',lounge_token:'token',...opts});
    a._sid='sid';a._gsession='gs';a._subscribe_active=true;return a;
}
let a=api({}),calls=[],done=[];
let l={phase:'connected',lounge:a};
a.on_state_change=(st)=>{l._current_state={...st};l._time_start=util.monotonic_ms();};
a._send_command=(n,p,cb)=>{push(calls,n);push(done,cb);};
a._process_event('nowPlaying',[{videoId:'abcdefghijk',state:1,currentTime:5,duration:60}]);
check(command(l,'pause',0,'').accepted,'pause accepted');
done[0](true);
check(l.command_pending && length(calls)==1 && a._command_verify!=null,'wait for event, no immediate query');
a._process_event('onStateChange',[{state:2,currentTime:5}]);
check(!l.command_pending && l.command_status=='sent' && a._command_verify==null && length(calls)==1,'synchronous event confirmation');
check(command(l,'play',0,'').accepted,'second command accepted');done[1](true);
a._connection_lost();
check(!l.command_pending && l.command_status=='failed' && a._command_verify==null,'disconnect clears verifier');
let b=api({skip_ads:false}),sent=[],complete=[];
b._send_command=(n,p,cb)=>{push(sent,n);push(complete,cb);};
b._command('getVolume');
b._process_event('adPlaying',[{adVideoId:'one',currentTime:5,isSkipEnabled:true}]);
let result=null;
check(b.skip_ad((ok)=>result=ok),'manual skip queued');
b._process_event('onAdStateChange',[{adState:1082}]);
check(result===false && index(sent,'skipAd')<0,'natural ad end cannot confirm unsent skip');
complete[0](true);b._connection_lost();
let c=api({skip_ads:true}),c_calls=[],c_done=[];
c._send_command=(n,p,cb)=>{push(c_calls,n);push(c_done,cb);};
c._command('getVolume');
c._process_event('adPlaying',[{adVideoId:'two',currentTime:5.19,duration:20,isSkippable:true,isSkipEnabled:false}]);
let d=api({skip_ads:true}),order=[];
d._send_command=(n,p,cb)=>{push(order,n);};
d.on_event=(n,args)=>push(order,'event');
d.on_state_change=()=>push(order,'state');
d._process_event('adPlaying',[{adVideoId:'three',currentTime:5,isSkipEnabled:true}]);
check(order[0]=='skipAd','unlock dispatch before external callbacks');
d._connection_lost();
let cfg={devices:[],skip_categories:[],skip_ads:true};
let listener=DeviceListener(SponsorBlockClient(cfg),cfg,{screen_id:'fixture',name:'TV',offset:0},false);
listener.lounge.lounge_token='token';listener._retry_jitter=0;
let t=util.monotonic_ms(),fast=0;
listener._run_loop=()=>{fast=util.monotonic_ms()-t;};
listener._retry(true,true);
u.timer(160,()=>{check(length(c_calls)==1,'probe waits for foreground');c_done[0](true);});
u.timer(420,()=>{
    check(length(c_calls)==2 && c_calls[1]=='getNowPlaying' && !c.ad.can_skip,'busy probe retries once without speculative skip');
    check(fast>=250 && fast<420,'fast reconnect timer');
    listener._retry(true,true);
    check(listener._last_fast_retry==t || listener._last_fast_retry-t<20,'fast retry cooldown retained');
    listener._loop_timer.cancel();listener._loop_timer=null;
    c._connection_lost();
    print('Event-driven confirmation, bounded busy probe, dispatch ordering, unsent skip and fast reconnect OK\n');u.end();
});
u.run();
