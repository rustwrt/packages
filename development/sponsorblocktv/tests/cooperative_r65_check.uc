'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import {initial_policy,valid_policy_value} from './lib/config.uc';
import {command,snapshot} from './lib/live.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
let cfg={devices:[],skip_categories:[],skip_ads:true,auto_play:true,mute_ads:true};
let l=DeviceListener(SponsorBlockClient(cfg),cfg,{screen_id:'fixture',name:'TV'},false);
let a=l.lounge;
check(a.controller_mode=='cooperative' && initial_policy(cfg,{}).controller_mode=='cooperative','default cooperative');
check(valid_policy_value('controller_mode','passive',false) && !valid_policy_value('controller_mode','bad',false),'validate mode');
check(a.device_id!=YtLoungeApi({screen_id:'fixture'}).device_id,'unique identities for same screen');
a._sid='sid';a._gsession='gs';a._subscribe_active=true;l.phase='connected';
let sent=[];
a._send_command=(n,p,cb)=>{push(sent,[n,{...p}]);if(n=='setVolume')a._process_event('onVolumeChanged',[{volume:p.volume,muted:p.muted}]);cb(true);};
function roster(external){
    let r=[{type:'LOUNGE_SCREEN',id:'screen'},{type:'REMOTE_CONTROL',id:a.device_id,name:'service'}];
    if(external)push(r,{type:'REMOTE_CONTROL',id:'phone',name:'Phone'});
    a._process_event('loungeStatus',[{devices:r}]);
}
a._process_event('onAutoplayModeChanged',[{autoplayMode:'DISABLED'}]);
check(!length(sent),'unknown roster does not enforce autoplay');
roster(true);
a._process_event('onAutoplayModeChanged',[{autoplayMode:'DISABLED'}]);
check(!length(sent) && a.shared_control(),'phone preference not overridden');
a._process_event('onVolumeChanged',[{volume:35,muted:false}]);
a._process_event('adPlaying',[{adVideoId:'ad1',currentTime:1,isSkipEnabled:false}]);
check(a._ad_mute_owned && !a._ad_mute_pending,'mute confirmed');
a._process_event('onVolumeChanged',[{volume:55,muted:false}]);
check(!a._ad_mute_owned && a.ad.manual_mute_override,'external unmute relinquishes ownership');
let n=length(sent);
a._process_event('onAdStateChange',[{adState:1081,isSkipEnabled:true}]);
check(sent[n][0]=='skipAd','skip retained with phone');
a._process_event('onAdStateChange',[{adState:1082}]);
check(a.volume_state.volume==55 && a.volume_state.muted=='false','no restore over phone volume');
a._process_event('nowPlaying',[{videoId:'abcdefghijk',state:1,currentTime:5,duration:60}]);
a._process_event('onStateChange',[{state:1,currentTime:20}]);
check(l._remote_seek_hold_until>util.monotonic_ms() && !l._can_auto_seek(),'yield after observed seek');
roster(false);check(index(map(sent,(x)=>x[0]),'setAutoplayMode')>=0,'sole controller resumes preference');
l.apply_policy('controller_mode','passive');
n=length(sent);
a._process_event('adPlaying',[{adVideoId:'ad2',currentTime:5,isSkipEnabled:true}]);
check(!a.skip_ads && !a.mute_ads && !command(l,'play',0,'').accepted && length(sent)==n,'passive prohibits mutations');
l.apply_policy('controller_mode','cooperative');check(a.skip_ads && a.mute_ads,'saved policies restored');
a._connection_lost();
print('Cooperative mode, unique IDs, autoplay arbitration, manual unmute, seek yield and passive guard OK\n');
