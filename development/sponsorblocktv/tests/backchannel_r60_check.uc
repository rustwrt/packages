'use strict';
import {DeviceListener} from './lib/runtime.uc';
import {SponsorBlockClient} from './lib/sponsorblock.uc';
import {snapshot} from './lib/live.uc';
let u=require('uloop');u.init();
if(!u.interval)u.interval=(ms,cb)=>u.timer(ms,cb);
function check(ok,msg){if(!ok)die(msg);}
let cfg={devices:[],skip_categories:[],skip_ads:true,mute_ads:false};
let l=DeviceListener(SponsorBlockClient(cfg),cfg,{screen_id:'fixture',name:'TV',offset:0,skip_ads:true,mute_ads:false},false);
let a=l.lounge,callbacks=[],sent=[],retries=0,connects=0;
l._retry=()=>retries++;
a.connect=(cb)=>{connects++;a._sid='same';a._gsession='gs';a._last_event_id=1;cb(true);};
a.subscribe=(cb)=>{a._subscribe_active=true;push(callbacks,cb);};
a._send_command=(n,p,cb)=>{push(sent,n);cb(true);};
l._connect_and_subscribe();
a._process_events([[2,['adPlaying',{adVideoId:'ad1',isSkippable:true,isSkipEnabled:false,currentTime:4,duration:20}]]]);
let epoch=a._command_epoch,ad=a.ad,cursor=a._last_event_id;
a._subscribe_active=false;callbacks[0](true);
check(connects==1 && length(callbacks)==2 && retries==0 && a._sid=='same' && a._command_epoch==epoch,'clean EOF renews same SID');
check(a.ad==ad && a._ad_active && a._last_event_id==cursor && snapshot(l).ad_active,'ad and cursor survive rollover');
a._process_events([[3,['onAdStateChange',{adState:1081,isSkipEnabled:true,currentTime:5}]]]);
check(index(sent,'skipAd')>=0,'skip works after rollover');
a._subscribe_active=false;callbacks[1](true);
check(a.ad==ad && a.ad.skip_sent && a._ad_retry_timer!=null && length(callbacks)==3,'pending skip survives rollover');
a._process_events([[4,['onAdStateChange',{adState:1082}]]]);
check(!a._ad_active,'ad ends normally');
a._subscribe_active=false;callbacks[2](true);
check(length(callbacks)==4 && retries==0,'renew after content transition');
a._subscribe_active=false;callbacks[3](true);
a._subscribe_active=false;callbacks[4](true);
a._subscribe_active=false;callbacks[5](true);
check(retries==1 && !a.connected() && l.phase=='reconnecting','bounded empty poll fallback');
check(l._status_timer==null,'status timer cleaned only on real teardown');
print('Clean rollover preserves SID/AID, ad skip and state; empty-poll guard OK\n');
