'use strict';
import {YtLoungeApi} from './lib/lounge.uc';
import * as util from './lib/util.uc';
let u=require('uloop');u.init();
function check(ok,msg){if(!ok)die(msg);}
function api(opts){
 let a=YtLoungeApi({screen_id:'fixture',lounge_token:'token',skip_ads:true,mute_ads:true,...opts});
 a._sid='s';a._gsession='g';a._subscribe_active=true;
 return a;
}
let a=api({}),calls=[],done=[];
a._send_command=(n,p,cb)=>{push(calls,[n,{...p},util.monotonic_ms()]);push(done,cb);};
a._process_event('onVolumeChanged',[{volume:37,muted:false}]);
let started=util.monotonic_ms();
a._process_event('onAdStateChange',[{adState:1080}]);
check(calls[0][0]=='setVolume' && calls[0][1].muted=='true' && calls[0][2]-started<10,'early ad signal dispatch <10ms');
print(sprintf('First ad signal to mute dispatch: %d ms\n',calls[0][2]-started));
a._process_event('onVolumeChanged',[{volume:37,muted:true}]);
check(a._ad_mute_owned && !a._ad_mute_pending && a._mute_verify==null,'mute confirmation does not wait for HTTP');
a._process_event('adPlaying',[{adVideoId:'one',isSkipEnabled:true}]);
check(length(calls)==1 && a._command_queue[0].name=='skipAd','skip next after in-flight mute');
let unlocked=util.monotonic_ms();done[0](true);
check(calls[1][0]=='skipAd' && calls[1][2]-unlocked<10,'skip dispatch immediately when transport free');
print(sprintf('Transport free to skip dispatch: %d ms\n',calls[1][2]-unlocked));
a._process_event('adPlaying',[{adVideoId:'two',isSkipEnabled:false}]);
check(a._ad_mute_owned && length(a._command_queue)==0,'consecutive ads stay muted');
done[1](true);
started=util.monotonic_ms();
a._process_event('onAdStateChange',[{adState:1082}]);
check(calls[2][0]=='setVolume' && calls[2][1].muted=='false' && calls[2][2]-started<10,'restore dispatch before status poll');
print(sprintf('Ad end to restore dispatch: %d ms\n',calls[2][2]-started));
a._process_event('onVolumeChanged',[{volume:37,muted:false}]);
check(!a._ad_mute_owned && !a._ad_mute_pending,'restore confirmed before HTTP');
done[2](true);
check(calls[3][0]=='getNowPlaying','content query follows restore');
a._connection_lost();
let b=api({}),b_calls=[],b_done=[];
b._send_command=(n,p,cb)=>{push(b_calls,n);push(b_done,cb);};
b._process_event('onVolumeChanged',[{volume:40,muted:false}]);
b._command('getNowPlaying');
b._process_event('adPlaying',[{adVideoId:'ad',isSkipEnabled:false}]);
b._process_event('onVolumeChanged',[{volume:40,muted:true}]);
b_done[0](true);
check(length(b_calls)==1 && !b._ad_mute_owned && !b._ad_mute_pending,'external mute before dispatch not owned');
b._process_event('onAdStateChange',[{adState:1082}]);
check(index(b_calls,'setVolume')<0,'never unmute user-muted TV');b._connection_lost();
let c=api({}),c_calls=[],c_done=[];
c._send_command=(n,p,cb)=>{push(c_calls,n);push(c_done,cb);};
c._command('getNowPlaying');c._command('pause');c._command('getVolume');
c._process_event('adPlaying',[{adVideoId:'unknown',isSkipEnabled:false}]);
check(c._command_queue[0].name=='getVolume','unknown volume query promoted ahead of queued mutation');
c_done[0](true);
check(c_calls[1]=='getVolume','priority read dispatched');
c._process_event('onVolumeChanged',[{volume:50,muted:false}]);
check(c._command_queue[0].name=='setVolume','mute next after known state');
c_done[1](true);
check(c_calls[2]=='setVolume','mute sent before queued mutation');
c_done[2](true);
check(c._ad_mute_pending && c._mute_verify!=null,'missing observation awaits backchannel');
c._process_event('onVolumeChanged',[{volume:50,muted:true}]);
check(!c._ad_mute_pending && c._mute_verify==null,'event completes pending verification');
c._connection_lost();
let d=api({}),d_calls=[];
d._send_command=(n,p,cb)=>{push(d_calls,n);cb(true);};
d._process_event('onVolumeChanged',[{volume:40,muted:false}]);
d._process_event('adPlaying',[{adVideoId:'quick',isSkipEnabled:true}]);
check(d_calls[0]=='skipAd','immediately skippable ad retains skip priority');
d._process_event('onVolumeChanged',[{volume:40,muted:true}]);
d._process_event('onAdStateChange',[{adState:1082}]);
d._process_event('onVolumeChanged',[{volume:40,muted:false}]);
let count=length(d_calls);
u.timer(350,()=>{
 check(length(d_calls)==count,'confirmed mute and skip cancel delayed verification polls');
 d._connection_lost();print('PASS: immediate ad dispatch, event-driven mute, ownership, queue and consecutive ads\n');u.end();
});
u.run();
