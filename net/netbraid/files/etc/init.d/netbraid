#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load netbraid
	local enabled interval retention
	config_get_bool enabled main detector_enabled 0
	config_get interval detector interval 30
	config_get retention detector retention 900
	[ "$interval" -ge 5 ] 2>/dev/null || interval=30
	[ "$interval" -le 60 ] 2>/dev/null || interval=30
	[ "$retention" -ge 60 ] 2>/dev/null || retention=900
	[ "$retention" -le 86400 ] 2>/dev/null || retention=900
	procd_open_instance
	procd_set_param command /usr/sbin/netbraidd --config-dir /etc/config --status-file /var/run/netbraid/status.json --interval "$interval" --detection-enabled "$enabled" --detection-retention "$retention"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
