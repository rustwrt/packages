config netbraid 'main'
	option enabled '0'
	option mark_shift '16'
	option table_base '10000'
	option priority_base '20000'
	option health_enabled '1'
	option detector_enabled '0'
	option portal_enabled '0'
	option router_originated '0'
	option log_level 'notice'

config detector 'detector'
	option enabled '0'
	option interval '30'
	option ttl '1'
	option dhcp '1'
	option conntrack '1'
	option neighbor '1'
	option syn '0'
	option wifi '1'
	option retention '900'
	option mode 'auto'
	list whitelist '00:00:00:00:00:00'

config portal 'portal'
	option enabled '0'
	option interface 'guest'
	option session_timeout '3600'
	option guest_network 'guest'
	option title 'NetBraid Guest Access'
	option terms 'Use of this network is subject to local policy.'
