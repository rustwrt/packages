#!/bin/sh
# Preserve explicit choices from old releases; never modify other protocols.
. /lib/functions.sh
changed=0
failed=0
migrate_ipv6() {
 local iface="$1" proto old new
 config_get proto "$iface" proto
 [ "$proto" = warp ] || return 0
 config_get old "$iface" enable_ipv6
 [ -n "$old" ] || return 0
 config_get new "$iface" ipv6
 if [ -z "$new" ]; then
  case "$old" in
   0|off|false|no|disabled) new=0;;
   1|on|true|yes|enabled) new=1;;
   *) return 0;;
  esac
  uci set "network.$iface.ipv6=$new" || { failed=1; return 0; }
 fi
 uci delete "network.$iface.enable_ipv6" || { failed=1; return 0; }
 changed=1
}
config_load network
config_foreach migrate_ipv6 interface
[ "$changed" = 0 ] || uci commit network || failed=1
exit "$failed"
