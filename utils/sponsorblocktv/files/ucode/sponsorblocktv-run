#!/usr/bin/env ucode
// sponsorblocktv-run - headless launcher for SponsorBlockTV (ucode).
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Loads config.json, then runs the runtime for all paired devices inside the
// uloop event loop.

'use strict';

import * as fs from 'fs';
import * as util from '/usr/lib/sponsorblocktv/util.uc';
import * as runtime from '/usr/lib/sponsorblocktv/runtime.uc';
import {validate_runtime_config} from '/usr/lib/sponsorblocktv/config.uc';

let uloop = require('uloop');

const DEFAULT_DATA_DIR = '/etc/sponsorblocktv/data';

function parse_args(argv) {
    let args={data_dir:getenv('SBTV_DATA_DIR')||DEFAULT_DATA_DIR,debug:false,http_tracing:false,check_only:false};
    let seen={};
    for(let i=0;i<length(argv);i++){
        let flag=argv[i]=='-d'?'--data':argv[i];
        if(seen[flag] || index(['--data','--debug','--check','--http-tracing'],flag)<0)return null;
        seen[flag]=true;
        if(flag=='--data'){
            let value=argv[++i];
            if(type(value)!='string' || !length(value) || substr(value,0,1)=='-')return null;
            args.data_dir=value;
        }else if(flag=='--debug')args.debug=true;
        else if(flag=='--http-tracing')args.http_tracing=true;
        else args.check_only=true;
    }
    return args;
}

function load_config(data_dir) {
	let path = data_dir + '/config.json';
	let st=fs.lstat(path);
    if(!st || st.type!='file' || st.size>1048576 || st.size<2){
        util.error('run','Missing, invalid or oversized config.json');
        return null;
    }
    let text=fs.readfile(path);
    if(type(text)!='string' || length(text)>1048576){
        util.error('run','Unable to read configuration');
        return null;
    }
	let data;
	try {
		data = json(text);
	}
	catch (e) {
		util.error('run', 'config.json is not valid JSON');
		return null;
	}
	if (type(data) != 'object') {
		util.error('run', path + ' must contain a JSON object');
		return null;
	}
	return data;
}

function validate_config(config){
    try{return validate_runtime_config(config,false);}
    catch(e){util.error('run','Configuration rejected: '+e);return false;}
}

function main(argv) {
	let args = parse_args(argv);
    if(!args){util.error('run','Invalid launcher arguments');return 2;}
	util.set_log_level(args.debug ? 0 : 1);

	let config = load_config(args.data_dir);
	if (!config)
		return 1;
	if (!validate_config(config))
		return 1;

	if(args.check_only)return 0;
	if(config.use_proxy)util.warn('run','System proxy is not supported by this runtime; direct connections are used');
	// Keep offsets in milliseconds; DeviceListener converts exactly once.

	uloop.init();

	runtime.run(config, {
		data_dir: args.data_dir,
		debug: args.debug,
		http_tracing: args.http_tracing,
		on_exit: () => {
			util.info('run', 'Exited');
		},
	});

	uloop.run();
	return 0;
}

exit(main(ARGV));
