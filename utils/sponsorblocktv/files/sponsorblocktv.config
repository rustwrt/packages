# SponsorBlockTV - UCI configuration
#
# This file holds common settings and initial device policies. /etc/init.d/sponsorblocktv
# translates it into <data_dir>/config.json before (re)starting the daemon.
#
# Boolean options accept 0/1 (also true/false, yes/no).

config sponsorblocktv 'main'
	# Start the daemon on boot / when the service is (re)started.
	option enabled '0'

	# Log verbosity and HTTP request/response tracing.
	option debug '0'
	option http_tracing '0'

	# Directory holding the generated config.json (upstream: --data / iSPBTV_data_dir).
	option data_dir '/etc/sponsorblocktv/data'

	# Name other YouTube clients show for SponsorBlockTV in the device list.
	option join_name 'SponsorBlockTV'

	# Optional YouTube Data API key for Whitelist channel lookup. Empty uses public video metadata.
	option apikey ''

	# Report skipped segments to SponsorBlock (only the segment UUID is sent).
	option skip_count_tracking '1'

	# Reserved for compatibility; current runtime connects directly.
	option use_proxy '0'

	# SponsorBlock API endpoint.
	option sponsorblock_api_url 'https://sponsor.ajay.app/api/'

# Device sections are created only after a TV is added in LuCI or paired
# using sponsorblocktv-pair. A fresh installation has no devices.
# Per-TV policy defaults are assigned by pair_store.uc (NEW_TV_POLICY).

# Optional: channels excluded from SponsorBlock. Public metadata is used without an API key.
#config whitelist
#	option id ''
#	option name ''
