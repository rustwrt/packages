msgctxt "luci-app-warp"
msgid "Default follows the OpenWrt default Internet route. Registration and session keys are created automatically for each connection."
msgstr "Mặc định sử dụng tuyến Internet mặc định của OpenWrt. Thông tin đăng ký và khóa phiên được tạo tự động cho mỗi kết nối."

msgctxt "luci-app-warp"
msgid "Detailed Cloudflare WARP status"
msgstr "Trạng thái chi tiết Cloudflare WARP"

msgctxt "luci-app-warp"
