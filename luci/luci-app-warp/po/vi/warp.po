msgctxt "luci-app-warp"
msgid "Actual transport device"
msgstr "Thiết bị truyền tải thực tế"

msgctxt "luci-app-warp"
msgid "Choose an existing non-WARP upstream interface."
msgstr "Chọn giao diện kết nối Internet hiện có, không phải WARP."

msgctxt "luci-app-warp"
msgid "Cloudflare WARP"
msgstr "Cloudflare WARP"

msgctxt "luci-app-warp"
msgid "Cloudflare WARP Status"
msgstr "Trạng thái Cloudflare WARP"

msgctxt "luci-app-warp"
msgid "Cloudflare WARP status is unavailable."
